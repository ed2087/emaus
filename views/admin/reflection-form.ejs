<!-- views/admin/reflection-form.ejs -->
<%
  const pageCss = ['cms', 'cms-reflections', 'markdown'];
  const pageScripts = ['cms/cmsReflections', 'cms/uploadPreview', 'markdownParser','cms/markdownToolbar'];
%>

<%- include('../includes/head', { pageCss }) %>

<div class="admin-layout">
  <%- include('../includes/admin-sidebar') %>
  
  <main class="admin-content">
    <header class="admin-header">
      <h1><%= reflection ? 'Editar Reflexión' : 'Añadir Nueva Reflexión' %></h1>
      <div class="header-actions">
        <a href="/admin/reflections" class="btn btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Volver a Reflexiones
        </a>
      </div>
    </header>
    
    <div class="content-container">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <%= error %>
        </div>
      <% } %>
      
      <form action="<%= reflection ? '/admin/reflections/' + reflection._id + '?_method=PUT' : '/admin/reflections' %>" method="POST" class="form-layout" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="form-main">
            <div class="form-section">
              <div class="form-group">
                <label for="title">Título</label>
                <input 
                  type="text" 
                  id="title" 
                  name="title" 
                  value="<%= reflection ? reflection.title : '' %>" 
                  required
                  maxlength="200"
                >
              </div>
              
              <div class="form-group">
                <label for="description">Descripción</label>
                <textarea 
                  id="description" 
                  name="description" 
                  required
                  maxlength="500"
                ><%= reflection ? reflection.description : '' %></textarea>
                <div class="input-help">Resumen breve (máximo 500 caracteres)</div>
              </div>
              
              <div class="form-group">
                <label for="body">Contenido</label>
                
                <!-- Markdown Toolbar -->
                <div class="markdown-toolbar">
                  <button type="button" class="toolbar-btn" data-action="bold" title="Negrita (Ctrl+B)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path>
                      <path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path>
                    </svg>
                  </button>
                  
                  <button type="button" class="toolbar-btn" data-action="italic" title="Cursiva (Ctrl+I)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="19" y1="4" x2="10" y2="4"></line>
                      <line x1="14" y1="20" x2="5" y2="20"></line>
                      <line x1="15" y1="4" x2="9" y2="20"></line>
                    </svg>
                  </button>
                  
                  <div class="toolbar-separator"></div>
                  
                  <button type="button" class="toolbar-btn" data-action="heading" title="Encabezado">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M6 4v16M18 4v16M8 12h8"></path>
                    </svg>
                  </button>
                  
                  <button type="button" class="toolbar-btn" data-action="quote" title="Cita">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
                      <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
                    </svg>
                  </button>
                  
                  <button type="button" class="toolbar-btn" data-action="code" title="Código">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="16 18 22 12 16 6"></polyline>
                      <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                  </button>
                  
                  <div class="toolbar-separator"></div>
                  
                  <button type="button" class="toolbar-btn" data-action="link" title="Enlace">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                  </button>
                  
                  <button type="button" class="toolbar-btn" data-action="image" title="Imagen desde URL">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </button>
                  
                  <div class="toolbar-separator"></div>
                  
                  <button type="button" class="toolbar-btn" data-action="preview" title="Vista Previa">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                  </button>
                </div>
                
                <div class="editor-container">
                  <textarea 
                    id="body" 
                    name="body" 
                    class="editor-textarea" 
                    required
                    minlength="50"
                  ><%= reflection ? reflection.body : '' %></textarea>
                  
                  <!-- Preview Container -->
                  <div id="preview-container" class="preview-container" style="display: none;">
                    <div class="preview-header">
                      <span>Vista Previa</span>
                      <button type="button" class="close-preview">×</button>
                    </div>
                    <div id="preview-content" class="preview-content markdown-content"></div>
                  </div>
                </div>
                
                <div class="input-help">
                  <div class="markdown-help">
                    Usa la barra de herramientas arriba o escribe directamente: **negrita**, *cursiva*, [enlace](url), ![imagen](url), # Encabezado, > Cita, `código`
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="form-sidebar">
            <div class="form-section">
              <div class="form-group">
                <label for="category">Categoría</label>
                <select id="category" name="category" required>
                  <option value="">Selecciona una categoría</option>
                  <option value="Oración" <%= reflection && reflection.category === 'Oración' ? 'selected' : '' %>>Oración</option>
                  <option value="Comunidad" <%= reflection && reflection.category === 'Comunidad' ? 'selected' : '' %>>Comunidad</option>
                  <option value="Conversión" <%= reflection && reflection.category === 'Conversión' ? 'selected' : '' %>>Conversión</option>
                  <option value="Biblia" <%= reflection && reflection.category === 'Biblia' ? 'selected' : '' %>>Biblia</option>
                  <option value="Retiros" <%= reflection && reflection.category === 'Retiros' ? 'selected' : '' %>>Retiros</option>
                  <option value="Sanación y Esperanza" <%= reflection && reflection.category === 'Sanación y Esperanza' ? 'selected' : '' %>>Sanación y Esperanza</option>
                  <option value="Otro" <%= reflection && reflection.category === 'Otro' ? 'selected' : '' %>>Otro</option>
                </select>
              </div>
              
              <div class="form-group">
                <label for="tags">Etiquetas</label>
                <input 
                  type="text" 
                  id="tags" 
                  name="tags" 
                  value="<%= reflection && reflection.tags ? reflection.tags.join(', ') : '' %>" 
                >
                <div class="input-help">Etiquetas separadas por comas</div>
              </div>
              
              <!-- Enhanced Image Upload Section -->
              <div class="form-group">
                <label for="imageFiles">Subir Imágenes</label>
                <input 
                  type="file" 
                  id="imageFiles" 
                  name="imageFiles" 
                  multiple 
                  accept="image/*"
                  class="file-input"
                >
                <div class="input-help">Selecciona hasta 3 imágenes (JPG, PNG, GIF, WebP - máx. 5MB cada una)</div>
                
                <!-- Preview area for uploaded files -->
                <div id="upload-preview" class="upload-preview" style="display: none;">
                  <div class="preview-header">Imágenes seleccionadas:</div>
                  <div id="preview-container-upload" class="preview-container-grid"></div>
                </div>
              </div>

              <div class="form-group">
                <label for="images">URLs de Imágenes (opcional)</label>
                <textarea 
                  id="images" 
                  name="images" 
                  rows="3"
                  placeholder="https://ejemplo.com/imagen1.jpg&#10;https://ejemplo.com/imagen2.jpg"
                ><%= reflection && reflection.images ? reflection.images.join('\n') : '' %></textarea>
                <div class="input-help">Una URL por línea - se combinarán con las imágenes subidas (máximo 3 total)</div>
              </div>

              <!-- Existing images display for edit mode -->
              <% if (reflection && reflection.images && reflection.images.length > 0) { %>
                <div class="form-group">
                  <label>Imágenes Actuales</label>
                  <div class="current-images">
                    <% reflection.images.forEach((imageUrl, index) => { %>
                      <div class="current-image">
                        <img src="<%= imageUrl %>" alt="Imagen <%= index + 1 %>" style="max-width: 100px; max-height: 100px;">
                        <button type="button" class="remove-image-btn" data-image="<%= imageUrl %>">×</button>
                      </div>
                    <% }) %>
                  </div>
                  <div class="input-help">Haz clic en × para marcar imágenes para eliminar</div>
                </div>
              <% } %>
              
              <div class="form-group">
                <label for="author">Autor</label>
                <input 
                  type="text" 
                  id="author" 
                  name="author" 
                  value="<%= reflection ? reflection.author : (user.firstName + ' ' + user.lastName) %>" 
                >
              </div>
              
              <div class="form-group">
                <label for="bodyFormat">Formato</label>
                <select id="bodyFormat" name="bodyFormat">
                  <option value="markdown" <%= reflection && reflection.bodyFormat === 'markdown' ? 'selected' : '' %>>Markdown</option>
                  <option value="plain" <%= reflection && reflection.bodyFormat === 'plain' ? 'selected' : '' %>>Texto Plano</option>
                  <option value="html" <%= reflection && reflection.bodyFormat === 'html' ? 'selected' : '' %>>HTML</option>
                </select>
              </div>
              
              <div class="form-group checkbox-group">
                <label>
                  <input 
                    type="checkbox" 
                    name="isPublished" 
                    <%= reflection && reflection.isPublished ? 'checked' : '' %>
                  >
                  Publicar
                </label>
                <div class="input-help">Cuando no está marcado, se guarda como borrador</div>
              </div>
              
              <div class="form-group checkbox-group">
                <label>
                  <input 
                    type="checkbox" 
                    name="isPinned" 
                    <%= reflection && reflection.isPinned ? 'checked' : '' %>
                  >
                  Fijar en la Parte Superior
                </label>
                <div class="input-help">Destacado en la página de inicio y listados</div>
              </div>
            </div>
            
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <%= reflection ? 'Actualizar Reflexión' : 'Publicar Reflexión' %>
              </button>
              <% if (reflection) { %>
                <a href="/reflections/<%= reflection._id %>" class="btn btn-outline">Ver</a>
              <% } %>
            </div>
          </div>
        </div>
      </form>
    </div>
  </main>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.querySelector('form');
  
  if (form) {
    form.addEventListener('submit', function(e) {
      console.log('Form is submitting...');
      
      // Check form data
      const formData = new FormData(form);
      console.log('Form fields:');
      for (let [key, value] of formData.entries()) {
        console.log(key + ':', value);
      }
      
      // Check if all required fields have values
      const title = formData.get('title');
      const description = formData.get('description');
      const body = formData.get('body');
      
      console.log('Required fields check:');
      console.log('Title:', title);
      console.log('Description:', description);
      console.log('Body:', body);
      
      if (!title || !description || !body) {
        alert('Missing required fields!');
        e.preventDefault();
        return false;
      }
    });
  } else {
    console.log('Form not found!');
  }
});
</script>


<%- include('../includes/footer', { pageScripts }) %>
