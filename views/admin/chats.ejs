<%
  const pageCss = ['cms', 'cms-chats'];
%>

<%- include('../includes/head', { pageCss }) %>

<div class="admin-layout">
  <%- include('../includes/admin-sidebar') %>
  
  <main class="admin-main">
    <div class="admin-header">
      <h1>Manage Chats</h1>
      <a href="/admin/chats/new" class="btn btn-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Add New Chat
      </a>
    </div>
    
    <div class="admin-content">
      <div class="data-table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Type</th>
              <th>Created By</th>
              <th>Members</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (chats.length === 0) { %>
              <tr>
                <td colspan="7" class="empty-state">
                  <p>No chats found.</p>
                </td>
              </tr>
            <% } else { %>
              <% chats.forEach(chat => { %>
                <tr>
                  <td>
                    <div class="item-info">
                      <strong><%= chat.name %></strong>
                      <% if (chat.description) { %>
                        <small><%= chat.description %></small>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <span class="badge <%= chat.type === 'public' ? 'badge-success' : 'badge-warning' %>">
                      <%= chat.type === 'public' ? 'Public' : 'Private' %>
                    </span>
                  </td>
                  <td><%= chat.createdBy ? `${chat.createdBy.firstName} ${chat.createdBy.lastName}` : 'Unknown' %></td>
                  <td>
                    <% if (chat.type === 'public') { %>
                      <span class="text-muted">All members</span>
                    <% } else { %>
                      <%= chat.members.length %> members
                    <% } %>
                  </td>
                  <td>
                    <span class="status-badge <%= chat.isActive ? 'active' : 'inactive' %>">
                      <%= chat.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td>
                    <time datetime="<%= chat.createdAt %>">
                      <%= new Date(chat.createdAt).toLocaleDateString('es-ES') %>
                    </time>
                  </td>
                  <td>
                    <div class="action-buttons">
                      <a href="/admin/chats/edit/<%= chat._id %>" class="btn btn-sm btn-outline" title="Edit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                          <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                      </a>
                      <% if (user.role === 'admin') { %>
                        <button class="btn btn-sm btn-danger" onclick="deleteChat('<%= chat._id %>')" title="Delete">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          </svg>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
          <% if (pagination.hasPrev) { %>
            <a href="?page=<%= pagination.page - 1 %>" class="pagination-btn prev">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              Previous
            </a>
          <% } %>
          
          <span class="pagination-info">
            Page <%= pagination.page %> of <%= pagination.totalPages %>
          </span>
          
          <% if (pagination.hasNext) { %>
            <a href="?page=<%= pagination.page + 1 %>" class="pagination-btn next">
              Next
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 6 15 12 9 18"></polyline>
              </svg>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
async function deleteChat(chatId) {
  if (!confirm('Are you sure you want to delete this chat? This will also delete all messages in the chat.')) {
    return;
  }
  
  try {
    const response = await fetch(`/admin/chats/${chatId}`, {
      method: 'DELETE'
    });
    
    const result = await response.json();
    
    if (result.success) {
      location.reload();
    } else {
      alert('Error deleting chat: ' + result.message);
    }
  } catch (error) {
    console.error('Error:', error);
    alert('An error occurred while deleting the chat.');
  }
}
</script>

<%- include('../includes/footer') %>